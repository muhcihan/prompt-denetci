{
  "manifest_version": 3,
  "name": "Prompt Denetçisi",
  "version": "2.0.0",
  "description": "Başlıca AI sitelerinde (ChatGPT, Claude, Gemini, Perplexity, Grok) ilk promptunu bir prompt mühendisi gibi ele alır: eksik bilgiler için seçenekli veya serbest cevaplanabilir sorular sorar, verdiğin cevapları harmanlayarak sıfırdan profesyonel bir prompt sentezler. Kendi API anahtarınla çalışır, hiçbir veri sunucuya gönderilmez.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://grok.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Prompt Denetçisi Ayarları"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
